filters:
  and:
    - Kingdom == "Plantae"
views:
  - type: cards
    name: Plantae
    order:
      - file.name
      - Kingdom
      - Order
      - Phylum
      - Species
      - Domain
      - Family
      - Class
      - aliases
    cardSize: 270
    image: note.Cover
    imageAspectRatio: 1
  - type: table
    name: Table
